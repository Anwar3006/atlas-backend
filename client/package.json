{
  "name": "@anwar3006/api-client",
  "version": "0.0.0",
  "description": "Generated TypeScript client for the Atlas API (auto-generated by @hey-api/openapi-ts -- do not edit src/ by hand)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate": "openapi-ts -i \"$OPENAPI_SPEC_URL\" -o src -c @hey-api/client-fetch",
    "build": "tsc"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.3",
    "typescript": "6.0.3"
  }
}
