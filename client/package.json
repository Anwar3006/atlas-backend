{
  "name": "@anwar3006/api-client",
  "version": "0.0.0",
  "description": "Generated TypeScript client for the Atlas API (auto-generated by @hey-api/openapi-ts -- do not edit src/ by hand)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate": "openapi-ts -i \"$OPENAPI_SPEC_URL\" -o src -c @hey-api/client-fetch",
    "build": "tsc"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.3",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
